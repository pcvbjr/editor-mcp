{
  "name": "@editor-mcp/demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "concurrently -k -n server,client -c cyan,magenta \"tsx watch src/server.ts\" \"vite\"",
    "start": "node dist/server/server.js",
    "typecheck": "tsc -b --pretty false && tsc -p client/tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@editor-mcp/adapter-tiptap-hocuspocus": "workspace:*",
    "@editor-mcp/core": "workspace:*",
    "@editor-mcp/document-service": "workspace:*",
    "@editor-mcp/mcp-server": "workspace:*",
    "@editor-mcp/protocol": "workspace:*",
    "@editor-mcp/reference-server": "workspace:*",
    "@editor-mcp/runtime-hocuspocus": "workspace:*",
    "@hocuspocus/provider": "^4.4.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tiptap/core": "3.28.0",
    "@tiptap/extension-collaboration": "3.28.0",
    "@tiptap/extension-table": "3.28.0",
    "@tiptap/extension-unique-id": "3.28.0",
    "@tiptap/react": "3.28.0",
    "@tiptap/starter-kit": "3.28.0",
    "express": "5.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "vite": "latest",
    "vitest": "4.1.10"
  }
}
